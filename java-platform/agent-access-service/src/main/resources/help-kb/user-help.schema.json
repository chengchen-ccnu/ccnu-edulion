{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edu-lion.local/schemas/user-help.schema.json",
  "title": "Edu Lion 中文用户帮助知识库",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "locale", "articles"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"},
    "locale": {"const": "zh-CN"},
    "articles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["articleId", "topic", "title", "keywords", "highPrecisionRules", "body", "version"],
        "properties": {
          "articleId": {"type": "string", "pattern": "^help_[a-z0-9_]{3,64}$"},
          "topic": {"type": "string", "enum": ["AUTH", "ACCOUNT_SECURITY", "COURSES", "LEARNING_CONTENT", "PRACTICE", "ASSESSMENT", "RESULTS", "PROGRESS", "AI_BOUNDARIES"]},
          "title": {"type": "string", "minLength": 2, "maxLength": 80},
          "keywords": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 30}},
          "highPrecisionRules": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 80}},
          "body": {"type": "string", "minLength": 30, "maxLength": 1200},
          "version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"},
          "appRoute": {"type": "string", "pattern": "^/[a-z0-9-]+(?:/[a-z0-9-]+)*$", "maxLength": 120}
        }
      }
    }
  }
}
