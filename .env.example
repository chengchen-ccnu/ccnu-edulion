# OpenAI 兼容接口（例如通义千问兼容模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.5-flash

# Java local profile：凭据和实际资源标识必须仅保存在未跟踪的 .env 或当前进程环境中
SPRING_PROFILES_ACTIVE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_SERVER_TIMEZONE=Asia/Shanghai
MYSQL_SSL_ENABLED=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
IAM_MYSQL_DATABASE=
IAM_JWT_SECRET=
IAM_JWT_ISSUER=edu-platform-iam
IAM_JWT_AUDIENCE=edu-platform-gateway
IAM_ACCESS_TOKEN_TTL=15m
IAM_REFRESH_TOKEN_TTL=7d
IAM_REFRESH_COOKIE_SECURE=false
IAM_LOGIN_RATE_LIMIT_ATTEMPTS=5
IAM_LOGIN_RATE_LIMIT_WINDOW=15m
IAM_SECURITY_STORE=redis
IAM_VERIFICATION_TTL=10m
IAM_VERIFICATION_COOLDOWN=60s
IAM_VERIFICATION_MAX_ATTEMPTS=5
IAM_VERIFICATION_DELIVERY_MODE=disabled
IAM_VERIFICATION_FIXED_CODE=
IAM_VERIFICATION_HMAC_SECRET=
IAM_SESSION_VERSION_KEY_PREFIX=edu:iam:session-version
IAM_SESSION_VERSION_CACHE_TTL=20m
IAM_MEDIA_REQUEST_TIMEOUT=5s
IAM_SEED_ENABLED=false
IAM_SEED_PASSWORD=
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_KEY_PREFIX=edu:gateway:rate
GATEWAY_SESSION_VALIDATION_ENABLED=true
GATEWAY_SECURITY_RETRY_AFTER=2s
VITE_GATEWAY_BASE_URL=http://localhost:8080
VITE_STUDENT_WEB_URL=http://localhost:5173
VITE_TEACHER_WEB_URL=http://localhost:5174
VITE_ADMIN_WEB_URL=http://localhost:5175
COURSE_MYSQL_DATABASE=
COURSE_SEED_ENABLED=false
MEDIA_MYSQL_DATABASE=
LEARNING_MYSQL_DATABASE=
OPERATION_MYSQL_DATABASE=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
GATEWAY_REDIS_DATABASE=0
IAM_REDIS_DATABASE=1
COURSE_REDIS_DATABASE=2
MEDIA_REDIS_DATABASE=3
LEARNING_REDIS_DATABASE=4
OPERATION_REDIS_DATABASE=5

# media-service 的 OSS 配置；远程 OSS 凭据只从进程环境或密钥管理注入，不得复制到 local.env
# 浏览器只获得对象级短期 URL，不得获得这些服务端凭据
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_KEY_PREFIX=quarantine
MEDIA_UPLOAD_GRANT_TTL=15m
MEDIA_ACCESS_GRANT_TTL=10m
MEDIA_UPLOAD_SESSION_TTL=24h
MEDIA_MULTIPART_THRESHOLD_BYTES=10485760
MEDIA_MULTIPART_PART_SIZE_BYTES=5242880
MEDIA_UNBOUND_RETENTION=24h
MEDIA_MAINTENANCE_ENABLED=true
MEDIA_WORKER_ENABLED=true
FFMPEG_PATH=ffmpeg
MEDIA_FFMPEG_TIMEOUT=2m
MEDIA_WORKER_MAX_CONCURRENT_JOBS=1
MEDIA_HLS_SEGMENT_DURATION=6s

# course-service 只调用 media-service JSON 契约并发布稳定引用事件，不接触 OSS 凭据
MEDIA_SERVICE_BASE_URL=http://127.0.0.1:8083
COURSE_MEDIA_REQUEST_TIMEOUT=3s
COURSE_MEDIA_OUTBOX_POLL_DELAY=2s
COURSE_MEDIA_CONFIRM_TIMEOUT=10s
COURSE_MEDIA_OUTBOX_MAX_ATTEMPTS=20

# learning-service 只经 media-service 短期授权读取题库导入源，不接触 OSS 凭据
LEARNING_MEDIA_REQUEST_TIMEOUT=5s
QUESTION_IMPORT_MAX_SOURCE_BYTES=104857600
QUESTION_IMPORT_RETENTION=7d
LEARNING_OUTBOX_POLL_DELAY=2s
LEARNING_OUTBOX_CONFIRM_TIMEOUT=10s
LEARNING_OUTBOX_MAX_ATTEMPTS=20
LEARNING_PROGRESS_BUFFER_ENABLED=true
LEARNING_PROGRESS_BUFFER_WORKER_DELAY=5s
LEARNING_PROGRESS_BUFFER_BATCH_SIZE=1000
LEARNING_PROGRESS_BUFFER_WORKER_CONCURRENCY=16
LEARNING_PROGRESS_BUFFER_LEASE_DURATION=15s
LEARNING_PROGRESS_BUFFER_BACKLOG_THRESHOLD=10000
LEARNING_COURSE_FACT_CACHE_TTL=1s

# RabbitMQ 仅由启用消息消费/Outbox 的服务使用；密码只放仓库外本地配置或 Secret
RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# 默认复用相邻旧项目的大型资产，可改成新的绝对路径
EDU_AGENT_ASSET_ROOT=../edu_agent/智能体项目
BGE_MODEL_PATH=../edu_agent/bge-base-zh

# 检索参数，需要使用评测集进一步校准
QUESTION_SCORE_THRESHOLD=0.42
KNOWLEDGE_SCORE_THRESHOLD=0.38
VECTOR_CANDIDATE_K=30
KEYWORD_CANDIDATE_K=30
RERANK_TOP_K=10

# 教学循环保护
MAX_STEP_RETRIES=3
MAX_LLM_CALLS=30

# 留空时使用进程内存保存会话；生产环境建议配置 PostgreSQL
DATABASE_URL=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
